# Copy this file to .env and fill in real values. Never commit .env.
DB_USER=username
DB_PASSWORD=change-me
DB_NAME=todo
# localhost when running `go run` on your machine; becomes `db` inside docker compose (Step 9)
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=disable

# Backend API
APP_PORT=8080
# At least 32 chars. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more

# pgAdmin web login (http://localhost:5050)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me
